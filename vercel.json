{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/clientDashboard.html",
      "destination": "/Clientdashboard.html"
    },
    {
      "source": "/",
      "destination": "/login.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/$1"
    }
  ]
}

